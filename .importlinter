[importlinter]
root_packages =
    d810
    d810_egglog
    tests
include_external_packages = True
exclude_type_checking_imports = True

[importlinter:contract:manifest-is-cheap]
name = The root manifest must not import runtime or rules
type = forbidden
allow_indirect_imports = True
source_modules =
    d810_egglog
forbidden_modules =
    d810_egglog.runtime
    d810_egglog.rules

[importlinter:contract:extension-no-ida]
name = Portable extension modules must not import IDA or Hex-Rays
type = forbidden
allow_indirect_imports = True
source_modules =
    d810_egglog
forbidden_modules =
    idaapi
    ida_hexrays
    ida_kernwin
    ida_loader
    ida_funcs
    ida_bytes
    ida_name
    idc
    idautils
    idapro

[importlinter:contract:extension-no-manager-ui]
name = Extension modules must not import manager or UI layers
type = forbidden
allow_indirect_imports = True
source_modules =
    d810_egglog
forbidden_modules =
    d810.manager
    d810.ui

[importlinter:contract:extension-d810-direct-boundary]
# This is intentionally a direct-edge boundary. The three exact exceptions
# below are the extension's integration ports: the portable DTO contract, the
# IDA-bound host facade, and the minimum optimizer registration base. The host
# facades transitively depend on D810 internals, so setting
# allow_indirect_imports=False would reject these approved adapters themselves.
# Keep the exceptions target-specific: every other direct import from the
# extension into the d810 tree must fail.
name = Extension modules use only the approved direct D810 integration ports
type = forbidden
allow_indirect_imports = True
source_modules =
    d810_egglog
forbidden_modules =
    d810
ignore_imports =
    d810_egglog.** -> d810.mba.extension_api
    d810_egglog.** -> d810.backends.mba.extension_host
    d810_egglog.** -> d810.optimizers.microcode.instructions.peephole.handler
unmatched_ignore_imports_alerting = none
